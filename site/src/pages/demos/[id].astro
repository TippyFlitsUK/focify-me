---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const demos = await getCollection("demos");
  return demos.map((d) => ({ params: { id: d.id }, props: { demo: d } }));
}
const { demo } = Astro.props;
const { Content } = await render(demo);
const guides = (await getCollection("guides")).filter((g) => g.data.demo === demo.id);
---
<Base title={demo.data.title} section="demos" heading={demo.data.title} tagline={demo.data.summary}>
  <section class="result-section">
    <div class="result-card">
      <div class="result-row"><span class="result-label">Built by</span><span class="result-value">{demo.data.owner}</span></div>
      <div class="result-row"><span class="result-label">Status</span><span class={`result-value ${demo.data.status}`}>{demo.data.status}</span></div>
      {demo.data.verified && <div class="result-row"><span class="result-label">Checked</span><span class="result-value">{demo.data.verified}</span></div>}
      {demo.data.stack.length > 0 && <div class="result-row"><span class="result-label">Stack</span><span class="result-value">{demo.data.stack.join(", ")}</span></div>}
      <div class="result-row"><span class="result-label">URL</span><span class="result-value"><a href={demo.data.url} target="_blank">{demo.data.url}</a></span></div>
      <a class="visit-btn" href={demo.data.url} target="_blank">Open the demo</a>
      {(demo.data.source || guides.length > 0) && (
        <div class="action-btns">
          {demo.data.source && <a href={demo.data.source} target="_blank">Source</a>}
          {guides.map((g) => <a href={`../../guides/${g.id}/`}>{g.data.title}</a>)}
        </div>
      )}
      <div class="prose"><Content /></div>
    </div>
  </section>
</Base>
