---
import "../styles/global.css";
const {
  title,
  description = "Demos and guides for Filecoin Onchain Cloud, from the people who FOCify websites.",
  heading = "Website to Filecoin in seconds",
  tagline,
  cta,          // optional { href, label } primary button under the tagline
  section = "",
} = Astro.props;
const fullTitle = title ? `${title} - FOCify.ME` : "FOCify.ME - See Filecoin Onchain Cloud working";
// Document-relative links so the build works on subdomain and path gateways.
const depth = Astro.url.pathname.split("/").filter(Boolean).length;
const root = depth ? "../".repeat(depth) : "./";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="icon" type="image/png" href={`${root}icon.png`}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

<header class="bar"><div class="bar-in">
  <a href={root}><img src={`${root}focify.png`} alt="FOCify.ME"></a>
  <nav class="nav">
    <a href={`${root}`}>Convert</a>
    <a href={`${root}demos/`} class={section === "demos" ? "active" : ""}>Demos</a>
    <a href={`${root}guides/`} class={section === "guides" ? "active" : ""}>Guides</a>
    <a href={`${root}about/`} class={section === "about" ? "active" : ""}>About</a>
  </nav>
</div></header>

<section class={section ? "hero sub" : "hero"}>
  <h1>{heading}</h1>
  {tagline ? <p class="tagline"><Fragment set:html={tagline} /></p> : <p class="tagline">Enter any URL and watch it go live on <span>Filecoin Onchain Cloud</span></p>}
  {cta && <p class="cta"><a class="focify-btn" href={cta.href}>{cta.label}</a></p>}
</section>

<slot />

<footer><div class="foot-in">
  <div class="links">
    <a href="https://github.com/TippyFlitsUK/focify-me" target="_blank">GitHub</a>
    <a href="https://github.com/filecoin-project/filecoin-pin" target="_blank">filecoin-pin</a>
    <a href="https://filecoin.cloud" target="_blank">Filecoin Onchain Cloud</a>
  </div>
  <p>focify.me is a personal, unofficial project. It is not affiliated with FilOz, the Filecoin Foundation or Protocol Labs.</p>
</div></footer>

</body>
</html>
