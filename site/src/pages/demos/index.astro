---
import Base from "../../layouts/Base.astro";
import DemoCard from "../../components/DemoCard.astro";
import { getCollection } from "astro:content";
const demos = (await getCollection("demos")).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Demos" section="demos" heading="Demos" tagline="Every demo listed here links to where it lives on <span>Filecoin Onchain Cloud</span>">
  <section class="focified-section">
    <p class="subtitle">Nothing is rehosted. The date is the last day someone confirmed it working.</p>
    <div class="focified-grid">
      {demos.map((d) => <DemoCard demo={d} href={`./${d.id}/`} />)}
    </div>
  </section>
</Base>
