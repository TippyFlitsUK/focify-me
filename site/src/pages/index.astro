---
import Base from "../layouts/Base.astro";
import DemoCard from "../components/DemoCard.astro";
import GuideCard from "../components/GuideCard.astro";
import { getCollection } from "astro:content";
const demos = (await getCollection("demos")).filter((d) => d.data.status === "live").sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);
---
<Base tagline="Working demos and short guides for <span>Filecoin Onchain Cloud</span>">
  <section class="focified-section" style="padding-bottom:32px;text-align:center">
    <a class="focify-btn" href="./demo/">FOCify a website</a>
    <p class="subtitle" style="margin:12px 0 0">Paste a URL, get a copy of the site on Filecoin. Free on the calibration testnet.</p>
  </section>

  <section class="focified-section">
    <img class="focified-logo" src="./focified.png" alt="The FOCified">
    <p class="subtitle">Things already running on Filecoin Onchain Cloud</p>
    <div class="focified-grid">
      {demos.map((d) => <DemoCard demo={d} href={`./demos/${d.id}/`} />)}
    </div>
  </section>

  <section class="focified-section">
    <h2>Guides</h2>
    <p class="subtitle">Short, practical, and pointing at the official docs for the details</p>
    <div class="focified-grid">
      {guides.map((g) => <GuideCard guide={g} href={`./guides/${g.id}/`} />)}
    </div>
  </section>
</Base>
