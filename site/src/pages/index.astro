---
import Base from "../layouts/Base.astro";
import DemoCard from "../components/DemoCard.astro";
import GuideCard from "../components/GuideCard.astro";
import { getCollection } from "astro:content";
// The converter has its own button in the hero, so the grid lists the others.
const demos = (await getCollection("demos")).filter((d) => d.data.status === "live" && d.id !== "site-converter").sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);
---
<Base
  heading="See Filecoin Onchain Cloud working"
  tagline="Demos you can click, guides you can follow, and a converter that puts any website on <span>Filecoin Onchain Cloud</span>"
  cta={{ href: "./demo/", label: "FOCify a website" }}
>
  <section class="focified-section">
    <img class="focified-logo" src="./focified.png" alt="The FOCified">
    <p class="subtitle">Demos already running on Filecoin Onchain Cloud</p>
    <div class="focified-grid">
      {demos.map((d) => <DemoCard demo={d} href={`./demos/${d.id}/`} />)}
    </div>
  </section>

  <section class="focified-section">
    <h2>Guides</h2>
    <p class="subtitle">Short, practical, and pointing at the official docs for the details</p>
    <div class="focified-grid">
      {guides.map((g) => <GuideCard guide={g} href={`./guides/${g.id}/`} />)}
    </div>
  </section>
</Base>
