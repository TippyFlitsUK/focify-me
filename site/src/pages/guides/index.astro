---
import Base from "../../layouts/Base.astro";
import GuideCard from "../../components/GuideCard.astro";
import { getCollection } from "astro:content";
const guides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Guides" section="guides" heading="Guides" tagline="Short walkthroughs for the demos, with links to the official <span>Filecoin Onchain Cloud</span> docs">
  <section class="focified-section">
    <div class="focified-grid">
      {guides.map((g) => <GuideCard guide={g} href={`./${g.id}/`} />)}
    </div>
  </section>
</Base>
